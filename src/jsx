export default function ComingSoonPage() {
  const [email, setEmail] = useState('')
  const [sent, setSent] = useState(false)
  const [loading, setLoading] = useState(false)

  const handleSubmit = async () => {
    if (!email || !email.includes('@')) return
    setLoading(true)
    // Simula registro — conectar a Supabase early_access tabla después
    await new Promise(r => setTimeout(r, 1000))
    setSent(true)
    setLoading(false)
  }

  return (
    <>
      <style>{styles}</style>
      <div className="cs-root">
        <div className="cs-glow" />
        <div className="cs-glow-gold" />

        {/* Logo */}
        <div className="cs-logo-wrap">
          <div className="cs-logo-ring" />
          <img
            src="/purelife-logo.png"
            alt="PureLife"
            className="cs-logo-img"
            onError={e => {
              e.target.style.display = 'none'
            }}
          />
        </div>

        {/* Brand */}
        <p className="cs-brand">PureLife Wellness Club</p>

        {/* Headline */}
        <h1 className="cs-headline">Coming<br />Soon</h1>
        <p className="cs-year">— 2026 —</p>

        <div className="cs-divider" />

        <p className="cs-tagline">
          A new era of wellness.<br />Powered by Dr. Smoothie AI.
        </p>

        {/* Email early access */}
        {!sent ? (
          <div className="cs-form">
            <input
              className="cs-input"
              type="email"
              placeholder="your@email.com"
              value={email}
              onChange={e => setEmail(e.target.value)}
              onKeyDown={e => e.key === 'Enter' && handleSubmit()}
            />
            <button
              className="cs-btn"
              onClick={handleSubmit}
              disabled={loading}
            >
              {loading ? 'Reserving...' : 'Get Early Access'}
            </button>
          </div>
        ) : (
          <p className="cs-success">✦ You're on the list. See you in 2026.</p>
        )}

        {/* Pillars */}
        <div className="cs-pills">
          {['AI Wellness', 'Smoothie Science', 'Longevity', 'Community'].map(p => (
            <span key={p} className="cs-pill">{p}</span>
          ))}
        </div>

        <p className="cs-footer">© 2026 JRMB Food Network LLC</p>
      </div>
    </>
  )
}
